# 共享客户端快照、工具缓存和提取产物的本机绝对路径
LOOMIX_DATA_ROOT=

# 网站资源：可选覆盖，开发和测试默认使用 resources/website/，生产默认读取网站 release.json。
# 本地目录相对于仓库根目录；完整发布流程要求使用已发布的 HTTPS 资源版本。
# VITE_RESOURCE_BASE_URL=resources/website/
# VITE_RESOURCE_BASE_URL=https://assets.loomix.fun/releases/0.95.2-r1/

# Cloudflare 账户：资源上传与网站部署共用。
CLOUDFLARE_ACCOUNT_ID=

# 网站部署：使用 Wrangler 登录或进程环境变量时无需填写。
CLOUDFLARE_API_TOKEN=

# R2 资源上传：授予目标存储桶对象读写权限，dry-run 无需配置。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
